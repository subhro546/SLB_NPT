// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model NPTRecord {
  id               Int      @id @default(autoincrement())
  borehole         String
  motherBorehole   String?
  fieldName        String
  spudDate         DateTime?
  section          String?
  startDate        DateTime
  endDate          DateTime
  hours            Float
  days             Float
  code             String
  subCode          String?
  responsible      String
  description      String?
  timeSavedDays    Float
  timeSavedHours   Float
  costImpact       Float
  costSaved        Float
}
